# Copie este arquivo para .env e preencha os valores
# cp .env.example .env

# ── Smiles API ────────────────────────────────────────────────────────────────
# Obtenha em: DevTools → Network → qualquer requisição para api-air-flightsearch-prd.smiles.com.br
SMILES_API_KEY=

# ── Telegram ─────────────────────────────────────────────────────────────────
# 1. Fale com @BotFather → /newbot → copie o token
# 2. Envie uma msg ao bot e acesse https://api.telegram.org/bot<TOKEN>/getUpdates → copie chat.id
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# ── WhatsApp (CallMeBot) ──────────────────────────────────────────────────────
# 1. Salve +34 644 59 78 46 e envie: "I allow callmebot to send me messages"
# 2. Você recebe a apikey por WhatsApp
CALLMEBOT_PHONE=        # DDI + DDD + número sem espaços e sem + (ex: 5511999887766)
CALLMEBOT_APIKEY=

# ── E-mail (Gmail) ────────────────────────────────────────────────────────────
# Use senha de app: myaccount.google.com → Segurança → Senhas de app
EMAIL_DE=
EMAIL_PARA=
EMAIL_SENHA=
